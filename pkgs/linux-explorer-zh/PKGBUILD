# Maintainer: Mike Solar <iam@mikesolar.cn>
#
# Windows 7 Explorer recreation with a Simplified Chinese UI.
# Built from the Mike-Solar fork: a Qt Linguist zh_CN catalog is installed and
# loaded at runtime, the icon view scrolls by rows instead of single cells,
# and a serif font fallback is avoided.

pkgname=linux-explorer-zh
_commit=38bba2a1a1b7ad5df958dfc1a35b5a6a2f6c2a63
pkgver=2.0.20261118
pkgrel=2
pkgdesc='The Windows 7 Explorer recreated on Linux with KIO, with Simplified Chinese UI'
arch=('x86_64')
url='https://github.com/Mike-Solar/linux-explorer'
license=('GPL-3.0-only')
depends=(
  'frameworkintegration' 'qt6-base' 'qt6-multimedia' 'kio' 'kcoreaddons' 'kconfig' 'kwidgetsaddons'
  'kwindowsystem' 'solid' 'libaero-qt' 'libcups' 'openssl' 'zlib'
)
optdepends=(
  'kio-extras: real search, and archives that open as folders'
  'kio-admin: Open as Administrator'
  'ark: Send to Compressed (zipped) folder'
  'ffmpegthumbs: thumbnails for video'
  'kdegraphics-thumbnailers: thumbnails for PDF and RAW'
  'kdenetwork-filesharing: Samba browsing behind Map network drive'
  'polkit: installing and uninstalling programs from the Control Panel'
  'yay: reinstalling AUR programs from Programs and Features'
  'ufw: firewall status on the Firewall page of the Control Panel'
)
makedepends=('cmake' 'ninja' 'extra-cmake-modules')
provides=('linux-explorer' 'linux-control')
conflicts=('linux-explorer' 'linux-control')
source=("$pkgname::git+https://github.com/Mike-Solar/linux-explorer.git#commit=$_commit")
sha256sums=('SKIP')

build() {
  cmake -S "$pkgname" -B build -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
  install -Dm644 "$pkgname/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
