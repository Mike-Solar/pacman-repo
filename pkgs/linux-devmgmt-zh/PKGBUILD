# Maintainer: Mike Solar <iam@mikesolar.cn>
#
# Windows 7 Device Manager recreation with a Simplified Chinese UI.
# Built from the Mike-Solar fork; the UI strings are translated directly
# because upstream has no translation infrastructure.

pkgname=linux-devmgmt-zh
_commit=ba7cd5183727f4828b27048ff502f16b5fee0289
pkgver=2.1.1.20261118
pkgrel=1
pkgdesc='A faithful recreation of the Windows 7 Device Manager, with Simplified Chinese UI'
arch=('x86_64')
url='https://github.com/Mike-Solar/linux-devmgmt'
license=('GPL-3.0-only')
depends=('qt6-base')
makedepends=('cmake' 'ninja')
provides=('linux-devmgmt')
conflicts=('linux-devmgmt')
source=("$pkgname::git+https://github.com/Mike-Solar/linux-devmgmt.git#commit=$_commit")
sha256sums=('SKIP')

build() {
  cmake -S "$pkgname" -B build -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
  install -Dm644 "$pkgname/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
