# Maintainer: Mike Solar <iam@mikesolar.cn>
#
# Windows 7 Control Panel recreation with a Simplified Chinese UI.
# linux-explorer 2.0 ships its own Control Panel and replaces this package
# upstream, so the two conflict by design; install one or the other.

pkgname=linux-control-zh
_commit=8ed7889005c36882fe154f592212234ee23703e0
pkgver=1.0.r8ed7889
pkgrel=1
pkgdesc='A faithful recreation of the Windows 7 Control Panel, with Simplified Chinese UI'
arch=('x86_64')
url='https://github.com/Mike-Solar/linux-control'
license=('GPL-3.0-only')
depends=('qt6-base' 'qt6-multimedia' 'kwidgetsaddons' 'kwindowsystem' 'libaero-qt' 'libcups' 'openssl' 'zlib')
makedepends=('cmake' 'ninja' 'extra-cmake-modules')
provides=('linux-control')
conflicts=('linux-control' 'linux-explorer')
source=("$pkgname::git+https://github.com/Mike-Solar/linux-control.git#commit=$_commit")
sha256sums=('SKIP')

build() {
  cmake -S "$pkgname" -B build -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
  install -Dm644 "$pkgname/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
